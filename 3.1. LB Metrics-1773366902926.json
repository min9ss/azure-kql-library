      },
      "pluginVersion": "12.4.1",
      "targets": [
        {
          "azureMonitor": {
            "aggregation": "Average",
            "alias": "{{resourcename}} ({{FrontendIPAddress}})",
            "allowedTimeGrainsMs": [
              60000,
              300000,
              900000,
              1800000,
              3600000,
              21600000,
              43200000,
              86400000
            ],
            "customNamespace": "microsoft.network/loadbalancers",
            "dimensionFilters": [
              {
                "dimension": "FrontendIPAddress",
                "filters": [],
                "operator": "eq"
              }
            ],
            "metricName": "DipAvailability",
            "metricNamespace": "microsoft.network/loadbalancers",
            "region": "",
            "resources": [
              {
                "metricNamespace": "microsoft.network/loadbalancers",
                "region": "",
                "resourceGroup": "$resourceGroup_LB",
                "resourceName": "$loadBalancer",
                "subscription": "$subscription"
              }
            ],
            "timeGrain": "auto",
            "top": ""
          },
          "azureResourceGraph": {
            "query": "resources\r\n| where type contains \"Microsoft.Network/loadBalancers\" and name =~ $loadBalancer\r\n| mv-expand  bepools = properties.backendAddressPools\r\n| project benic1 = bepools.properties.loadBalancerBackendAddresses\r\n| mv-expand  benic2 = benic1\r\n| project bepoolList = benic2.properties.ipAddress\r\n| where isnotnull(bepoolList)\r\n| project tostring(bepoolList)"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${ds}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$subscription",
          "subscriptions": [
            "$subscription"
          ]
        },
        {
          "azureMonitor": {
            "aggregation": "Average",
            "alias": "{{resourcename}} ({{FrontendIPAddress}})",
            "allowedTimeGrainsMs": [
              60000,
              300000,
              900000,
              1800000,
              3600000,
              21600000,
              43200000,
              86400000
            ],
            "customNamespace": "microsoft.network/loadbalancers",
            "dimensionFilters": [
              {
                "dimension": "FrontendIPAddress",
                "filters": [],
                "operator": "eq"
              }
            ],
            "metricName": "DipAvailability",
            "metricNamespace": "microsoft.network/loadbalancers",
            "region": "",
            "resources": [
              {
                "metricNamespace": "microsoft.network/loadbalancers",
                "region": "",
                "resourceGroup": "$resourceGroup_LB",
                "resourceName": "$loadBalancer",
                "subscription": "$subscription"
              }
            ],
            "timeGrain": "auto",
            "top": ""
          },
          "azureResourceGraph": {
            "query": "// NIC\r\nresources\r\n| where type contains \"Microsoft.Network/loadBalancers\" and name =~ $loadBalancer\r\n| mv-expand  bepools = properties.backendAddressPools\r\n| project benic1 = bepools.properties.loadBalancerBackendAddresses\r\n| mv-expand  benic2 = benic1\r\n| project ipconfId = tostring(benic2.properties.networkInterfaceIPConfiguration.id)\r\n| join kind=leftouter hint.strategy=shuffle(\r\n  resources\r\n  | where type =~ \"Microsoft.Network/networkInterfaces\"\r\n  | mv-expand ipconf = properties.ipConfigurations\r\n  | project privateIp = ipconf.properties.privateIPAddress, ipconfId = tostring(ipconf.id)) on ipconfId \r\n| parse ipconfId with * \"/networkInterfaces/\" nicName \"/\" *\r\n| where isnotempty(nicName)\r\n| project bepoolList = strcat(nicName, \" (\", privateIp, \")\")"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${ds}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "B",
          "subscription": "$subscription",
          "subscriptions": [
            "$subscription"
          ]
        }
      ],
      "title": "LB Backend List",
